<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="64dp"
    android:paddingVertical="32dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/brave_onboarding_title"
            style="@style/TvOnboardingTitle"
            android:text="@string/wdp_title" />
        <TextView
            android:id="@+id/brave_onboarding_subtitle"
            style="@style/TvOnboardingSubtitle"
            android:text="@string/wdp_text" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_later"
            style="@style/TvOnboardingButton"
            android:text="@string/maybe_later" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_sure"
            style="@style/TvOnboardingButton"
            android:text="@string/sure_ill_help_onboarding" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_learn_more"
            style="@style/TvOnboardingButton" />
    </LinearLayout>
</ScrollView>

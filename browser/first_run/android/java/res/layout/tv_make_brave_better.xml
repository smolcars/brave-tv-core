<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="64dp"
    android:paddingVertical="32dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/brave_onboarding_title"
            style="@style/TvOnboardingTitle"
            android:text="@string/p3a_title" />
        <TextView
            android:id="@+id/brave_onboarding_subtitle"
            style="@style/TvOnboardingSubtitle"
            android:text="@string/p3a_subtitle" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/send_crash_reports"
            style="@style/TvOnboardingCheckbox"
            android:text="@string/send_reports" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/send_p3a_reports"
            style="@style/TvOnboardingCheckbox"
            android:text="@string/send_p3a" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_start_browsing"
            style="@style/TvOnboardingButton"
            android:text="@string/start_browsing" />
    </LinearLayout>
</ScrollView>

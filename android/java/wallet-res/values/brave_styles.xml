<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="BraveDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="windowNoTitle">true</item>
    </style>
    <style name="BraveWalletTextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wallet_text_color</item>
        <item name="android:textColorLink">@color/brave_link</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="BraveWalletTextViewTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wallet_text_color</item>
        <item name="android:textColorLink">@color/brave_link</item>
        <item name="android:textAppearance">?attr/textAppearanceListItem</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BraveWalletTextViewSubTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brave_theme_subtitle_text</item>
        <item name="android:textColorLink">@color/brave_link</item>
        <item name="android:textAppearance">?attr/textAppearanceListItem</item>
    </style>
    <style name="BraveWalletCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/wallet_checkbox_background_color_selector</item>
        <item name="buttonIconTint">@color/wallet_checkbox_color_selector</item>

        <item name="android:textSize">@dimen/default_regular</item>
        <item name="lineHeight">20sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">400</item>
    </style>
    <style name="BraveWalletEditTextTheme">
        <!-- Text selection background color. -->
        <item name="android:textColorHighlight">@color/primary_20</item>
        <!-- Text selection handles color, blinking cursor color and selected border. -->
        <!-- It must be set as a theme at component level -->
        <!-- as we don't want to change it for the whole app. -->
        <item name="colorControlActivated">@color/icon_interactive</item>
        <!-- Hint text color that translates to the top of the view. -->
        <item name="android:textColorHint">@color/text_primary</item>
    </style>
    <style name="BraveWalletButton" parent="Widget.AppCompat.Button">
        <item name="buttonStyle">?android:attr/borderlessButtonStyle</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brave_white</item>
        <item name="android:background">@drawable/crypto_wallet_blue_button</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="BraveWalletOnboardingButton" parent="BraveWalletButton">
        <item name="android:background">@drawable/crypto_wallet_onboarding_blue_button</item>
        <item name="android:textColor">@color/crypto_wallet_onboarding_button_text_color</item>
        <item name="android:foreground">@null</item>
    </style>
    <style name="BraveWalletTextButton" parent="Widget.AppCompat.Button">
        <item name="buttonStyle">?android:attr/borderlessButtonStyle</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brave_action_color</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="BraveWalletButtonHollow" parent="Widget.AppCompat.Button">
        <item name="buttonStyle">?android:attr/borderlessButtonStyle</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wallet_text_color</item>
        <item name="android:background">@drawable/crypto_wallet_hollow_button</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="BraveWalletEditTextBordered" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wallet_text_color</item>
        <item name="android:background">@drawable/rounded_wallet_edittext</item>
        <item name="android:textColorHint">@color/brave_theme_hint_text</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">top</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="BraveWalletAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/wallet_bg</item>
        <item name="android:colorBackground">@color/wallet_bg</item>
     </style>
    <style name="BraveWalletTabsTextAppearance" parent="TextAppearance.Design.Tab">
      <item name="textAllCaps">false</item>
    </style>
    <style name="BraveWalletTextViewWhite">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="BraveWalletDAppNotificationDialogBottom" parent="@android:style/Theme.Dialog">
        <item name="android:windowMinWidthMajor">98%</item>
        <item name="android:windowMinWidthMinor">98%</item>
        <item name="android:windowAnimationStyle">@style/BraveWalletDialogBottomAnimation</item>
    </style>
    <style name="BraveWalletDialogBottomAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
    <style name="BraveWalletDAppNotificationDialogTop" parent="@android:style/Theme.Dialog">
        <item name="android:windowMinWidthMajor">98%</item>
        <item name="android:windowMinWidthMinor">98%</item>
        <item name="android:windowAnimationStyle">@style/BraveWalletDialogTopAnimation</item>
    </style>
    <style name="BraveWalletDialogTopAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_top</item>
        <item name="android:windowExitAnimation">@anim/slide_out_top</item>
    </style>
    <style name="ApproveTxBottomSheetDialogStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearanceRoundedCorners</item>
        <item name="shouldRemoveExpandedCorners">false</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="backgroundTint">@color/container_background</item>
    </style>
    <style name="ShapeAppearanceRoundedCorners" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>
    <style name="ApproveTxBottomSheetDialogTheme" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ApproveTxBottomSheetDialogStyle</item>
    </style>
    <style name="DefaultBold" parent="DefaultRegular">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Brave.PreferenceTitle.WalletDestructiveAction"
           parent="TextAppearance.TextLarge.Primary">
        <item name="android:textColor">@color/wallet_error_text_color</item>
    </style>
    <style name="LargeBold" parent="LargeSemibold">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="XSmallSemibold">
        <item name="android:textSize">@dimen/x_small_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">16sp</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">600</item>
    </style>
    <style name="XSmallBold" parent="XSmallSemibold">
        <item name="android:textStyle">bold</item>
    </style>
</resources>

import("//build/config/android/rules.gni")

# Instantiated inside Chromium AndroidX so private dependency targets retain
# their existing visibility. Files and dependency pins remain Brave-owned.
template("brave_androidx_tv_targets") {
  not_needed([ "target_name" ])
  not_needed(invoker, "*")

  android_aar_prebuilt("brave_material_icons_core_java") {
    aar_path =
        "//brave/third_party/androidx_tv/material-icons-core-android-1.7.8.aar"
    info_path = "//brave/third_party/androidx_tv/material-icons-core.info"
    deps = [
      "//third_party/androidx:androidx_compose_ui_ui_java",
      "//third_party/kotlin_stdlib:kotlin_stdlib_java",
    ]
  }

  android_aar_prebuilt("brave_tv_material_java") {
    aar_path = "//brave/third_party/androidx_tv/tv-material-1.1.0.aar"
    info_path = "//brave/third_party/androidx_tv/tv-material.info"
    deps = [
      ":brave_material_icons_core_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/androidx:androidx_compose_animation_animation_java",
      "//third_party/androidx:androidx_compose_foundation_foundation_java",
      "//third_party/androidx:androidx_compose_foundation_foundation_layout_java",
      "//third_party/androidx:androidx_compose_runtime_runtime_java",
      "//third_party/androidx:androidx_compose_ui_ui_geometry_java",
      "//third_party/androidx:androidx_compose_ui_ui_graphics_java",
      "//third_party/androidx:androidx_compose_ui_ui_java",
      "//third_party/androidx:androidx_compose_ui_ui_text_java",
      "//third_party/androidx:androidx_compose_ui_ui_util_java",
      "//third_party/androidx:androidx_profileinstaller_profileinstaller_java",
      "//third_party/kotlin_stdlib:kotlin_stdlib_java",
    ]
  }

  android_library("brave_tv_presentation_java") {
    sources = [
      "//brave/android/java/org/chromium/chrome/browser/tv/presentation/TvAddressEditor.kt",
      "//brave/android/java/org/chromium/chrome/browser/tv/presentation/TvPresentation.kt",
    ]
    enable_compose = true
    deps = [
      ":brave_tv_material_java",
      "//third_party/android_deps:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm_java",
      "//third_party/androidx:androidx_compose_foundation_foundation_java",
      "//third_party/androidx:androidx_compose_foundation_foundation_layout_java",
      "//third_party/androidx:androidx_compose_runtime_runtime_java",
      "//third_party/androidx:androidx_compose_ui_ui_graphics_java",
      "//third_party/androidx:androidx_compose_ui_ui_java",
      "//third_party/androidx:androidx_compose_ui_ui_text_java",
      "//third_party/androidx:androidx_compose_ui_ui_unit_java",
      "//third_party/androidx:androidx_lifecycle_lifecycle_common_java",
      "//third_party/androidx:androidx_lifecycle_lifecycle_runtime_java",
      "//third_party/androidx:androidx_savedstate_savedstate_java",
      "//third_party/kotlin_stdlib:kotlin_stdlib_java",
    ]
  }
}

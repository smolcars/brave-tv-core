import("//testing/test.gni")

source_set("signed_bundle") {
  visibility = [ ":*" ]
  sources = [
    "ad_block_bundle_store.cc",
    "ad_block_bundle_store.h",
    "ad_block_bundled_data.cc",
    "ad_block_bundled_data.h",
    "ad_block_signed_bundle.cc",
    "ad_block_signed_bundle.h",
  ]
  deps = [
    "//crypto",
    "//third_party/abseil-cpp:absl",
  ]
  public_deps = [ "//base" ]
  if (is_android) {
    deps += [
      "//brave/components/resources:static_resources",
      "//ui/base",
    ]
  }
}

source_set("bundle_updater") {
  visibility = [ ":*" ]
  sources = [
    "ad_block_bundle_updater.cc",
    "ad_block_bundle_updater.h",
  ]
  public_deps = [
    ":signed_bundle",
    "//services/network/public/cpp",
  ]
  deps = [
    "//components/prefs",
    "//net",
    "//url",
  ]
}

group("ad_block_signed_bundle_host_tests") {
  testonly = true
  deps = [ ":ad_block_signed_bundle_unittests($host_toolchain)" ]
}

if (current_toolchain == host_toolchain) {
  test("ad_block_signed_bundle_unittests") {
    # Only the mock loader helpers are needed, not the whole network service.
    sources = [
      "//services/network/test/test_url_loader_factory.cc",
      "//services/network/test/test_url_loader_factory.h",
      "//services/network/test/test_utils.cc",
      "//services/network/test/test_utils.h",
      "ad_block_signed_bundle_unittest.cc",
    ]
    deps = [
      ":bundle_updater",
      ":signed_bundle",
      "//base/test:test_support",
      "//components/prefs:test_support",
      "//crypto",
      "//mojo/core/test:run_all_unittests",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//testing/gtest",
    ]
  }
}

